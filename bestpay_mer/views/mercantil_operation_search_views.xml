<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bestpay_mercantil_operation_search_wizard_form" model="ir.ui.view">
        <field name="name">bestpay.mercantil.operation.search.wizard.form</field>
        <field name="model">bestpay.mercantil.operation.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultar operación Mercantil">
                <group>
                    <field name="transaction_id"/>
                    <field name="operation_type"/>
                    <field name="customer_id"/>
                    <field name="payment_reference"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="operation_date"/>
                    <field name="bank_code" invisible="operation_type != 'transfer'" required="operation_type == 'transfer'"/>
                    <field name="customer_phone_number" invisible="operation_type != 'mobile_payment'" required="operation_type == 'mobile_payment'"/>
                </group>
                <footer>
                    <button name="action_search_operation" string="Consultar y procesar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
