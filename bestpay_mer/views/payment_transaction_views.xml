<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_transaction_form_inherit_mercantil" model="ir.ui.view">
        <field name="name">payment.transaction.form.inherit.mercantil</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="bestpay.view_payment_transaction_form_bestpay"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_mercantil_operation_search"
                        string="Consultar operación Mercantil"
                        type="object"
                        class="btn-primary"
                        invisible="provider_code != 'mer' or state not in ('draft', 'pending')"/>
            </xpath>
            <xpath expr="//field[@name='bestpay_flow_type']" position="after">
                <field name="payment_link_client_mer" widget="CopyClipboardURL" readonly="1" invisible="provider_code != 'mer'"/>
                <field name="return_url_3ro" readonly="1" invisible="provider_code != 'mer'"/>
                <field name="trx_type" invisible="provider_code != 'mer'"/>
                <field name="mercantil_payment_concepts" readonly="1" invisible="provider_code != 'mer'"/>
            </xpath>
            <xpath expr="//field[@name='external_reference']" position="after">
                <field name="payment_link_bank_mer" widget="CopyClipboardURL" readonly="1" invisible="provider_code != 'mer'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Consultas Mercantil"
                      name="mercantil_operation_search"
                      invisible="provider_code != 'mer' or (state == 'done' and not mercantil_paid_by_manual_search)">
                    <field name="mercantil_paid_by_manual_search" invisible="1"/>
                    <group string="Montos ofrecidos históricamente">
                        <field name="mercantil_offered_amount_history" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                    <field name="mercantil_search_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="operation_type"/>
                            <field name="payment_reference"/>
                            <field name="amount"/>
                            <field name="operation_date"/>
                            <field name="result"/>
                            <field name="message"/>
                        </list>
                        <form create="0" delete="0" edit="0">
                            <sheet>
                                <group>
                                    <group string="Datos consultados">
                                        <field name="user_id" readonly="1"/>
                                        <field name="create_date" readonly="1"/>
                                        <field name="operation_type" readonly="1"/>
                                        <field name="customer_id" readonly="1"/>
                                        <field name="customer_phone_number" readonly="1"/>
                                        <field name="bank_code" readonly="1"/>
                                        <field name="merchant_account_number" readonly="1"/>
                                        <field name="merchant_phone_number" readonly="1"/>
                                        <field name="payment_reference" readonly="1"/>
                                        <field name="amount" readonly="1"/>
                                        <field name="operation_date" readonly="1"/>
                                        <field name="applied_offered_amount" readonly="1"/>
                                        <field name="applied_exchange_rate" readonly="1"/>
                                    </group>
                                    <group string="Resultado">
                                        <field name="result" readonly="1"/>
                                        <field name="message" readonly="1"/>
                                        <field name="http_status" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Solicitud enviada">
                                    <field name="request_payload" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                                </group>
                                <group string="Respuesta del banco">
                                    <field name="response_payload" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//group[@name='technical_logs']" position="inside">
                <div colspan="2" class="row mt-3" invisible="not webhook_3ro_state or webhook_3ro_state == 'na'">
                    <label for="webhook_3ro_state" string="Notificación al Tercero" class="col-sm-3 col-form-label fw-bold"/>
                    <div class="col-sm-9 d-flex align-items-center">
                        <field name="webhook_3ro_state" class="oe_inline" widget="badge" 
                            decoration-success="webhook_3ro_state == 'sent'" 
                            decoration-warning="webhook_3ro_state == 'pending'" 
                            decoration-danger="webhook_3ro_state == 'failed'"/>
                        <button name="action_retry_webhook_3ro" string="Reintentar ahora" type="object" 
                                class="btn-warning btn-sm ms-2" 
                                invisible="webhook_3ro_state not in ('pending', 'failed')"/>
                    </div>
                </div>
                <field name="webhook_3ro_attempts" invisible="not webhook_3ro_attempts"/>
                <field name="webhook_3ro_next_retry" invisible="webhook_3ro_state != 'pending'"/>

                <label for="webhook_3ro_payload" string="Payload enviado al Webhook del Tercero (JSON)" class="mt-3" invisible="not webhook_3ro_payload"/>
                <field name="webhook_3ro_payload" invisible="not webhook_3ro_payload" readonly="1" nolabel="1" widget="ace" options="{'mode': 'javascript'}"/>

                <label for="webhook_3ro_response" string="Respuesta del Webhook del Tercero" class="mt-3" invisible="not webhook_3ro_response"/>
                <field name="webhook_3ro_response" invisible="not webhook_3ro_response" readonly="1" nolabel="1" widget="ace" options="{'mode': 'javascript'}"/>
            </xpath>
        </field>
    </record>
</odoo>