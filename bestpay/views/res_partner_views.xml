<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_bestpay" model="ir.ui.view">
        <field name="name">res.partner.form.bestpay.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="BestPay API" name="bestpay_api">
                    <group>
                        <group string="Configuración de Acceso">
                            <field name="is_api_client"/>
                            <field name="bestpay_client_id"/>
                            <field name="bestpay_client_secret" password="True"/>
                        </group>
                        <group string="Permisos de Pasarelas" invisible="not is_api_client">
                            <field name="allowed_provider_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>