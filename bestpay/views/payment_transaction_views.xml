<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_transaction_form_bestpay" model="ir.ui.view">
        <field name="name">payment.transaction.form.bestpay.inherit</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='token_id']" position="after">
                <field name="uuid_hash" widget="CopyClipboardChar"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Información BestPay API" name="bestpay_info">
                        <group string="Control Cambiario (Venezuela - BCV)" name="bcv_conversion_group">
                            <group>
                                <field name="currency_ves_id" invisible="1"/>
                                
                                <field name="amount_ves" widget="monetary" options="{'currency_field': 'currency_ves_id'}" readonly="1" decoration-bf="1"/>
                                <field name="exchange_rate_bcv" readonly="1"/>
                            </group>
                            <group>
                                <field name="is_recalculable_ves" readonly="1" widget="boolean_toggle"/>
                            </group>
                        </group>

                        <hr/>

                        <group name="api_metadata_group">
                            <group string="Datos del Tercero">
                                <field name="bestpay_client_id" readonly="1"/>
                                <field name="external_reference" readonly="1"/>
                                <field name="client_note" readonly="1"/>
                            </group>
                            <group string="Respuesta y Flujo del Banco">
                                <field name="bestpay_flow_type" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Logs Técnicos de Comunicación" name="technical_logs">
                            <group colspan="2" col="1">
                                <label for="payment_request_payload" string="Payload de Solicitud API Original (JSON)"/>
                                <field name="payment_request_payload" 
                                    placeholder="JSON con el Request original del tercero..." 
                                    readonly="1" 
                                    nolabel="1"
                                    widget="ace" 
                                    options="{'mode': 'javascript'}"/>

                                <label for="bank_response_json" string="Datos de Respuesta Estructurados (JSON)"/>
                                <field name="bank_response_json" placeholder="JSON formateado para el cliente..." readonly="1" nolabel="1" widget="ace" options="{'mode': 'javascript'}"/>
                                
                                <separator string="Logs de Comunicación weebhook con el Banco" class="mt-3" invisible="not bank_raw_log"/>
                                <label for="bank_raw_log" string="Log Crudo del Banco" class="mt-3" invisible="not bank_raw_log"/>
                                <field name="bank_raw_log" placeholder="Respuesta cruda del banco..." invisible="not bank_raw_log" readonly="1" nolabel="1" widget="ace" options="{'mode': 'javascript'}"/>
                                <label for="bank_response_log" string="Respuesta Enviada al Banco" class="mt-3" invisible="not bank_response_log"/>
                                <field name="bank_response_log" placeholder="Respuesta enviada al banco..." invisible="not bank_response_log" readonly="1" nolabel="1" widget="ace" options="{'mode': 'javascript'}"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>