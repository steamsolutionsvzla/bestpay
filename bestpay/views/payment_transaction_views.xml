<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_payment_transaction_form_bestpay" model="ir.ui.view">
            <name>payment.transaction.form.bestpay.inherit</name>
            <model>payment.transaction</model>
            <inherit_id ref="payment.payment_transaction_form"/>
            <arch type="xml">
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Información BestPay API" name="bestpay_info">
                            <group>
                                <group string="Datos del Tercero">
                                    <field name="bestpay_client_id" readonly="1"/>
                                    <field name="external_reference" readonly="1"/>
                                    <field name="client_note" readonly="1"/>
                                </group>
                                <group string="Respuesta y Flujo del Banco">
                                    <field name="bestpay_flow_type" readonly="1"/>
                                </group>
                            </group>
                            <group string="Logs Técnicos de Comunicación">
                                <field name="bank_response_json" placeholder="JSON formateado para el cliente..." readonly="1"/>
                                <field name="bank_raw_log" placeholder="Respuesta cruda del banco..." readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </arch>
        </record>
    </data>
</odoo>