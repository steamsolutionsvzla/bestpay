<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_bestpay_errors_root"
              name="Errores"
              parent="bestpay.menu_bestpay_configuration"
              groups="base.group_system"
              sequence="90"/>

    <record id="view_bestpay_event_log_list" model="ir.ui.view">
        <field name="name">event.log.list</field>
        <field name="model">event.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="timestamp"/>
                <field name="is_error"/>
                <field name="controller"/>
                <field name="function_name"/>
                <field name="user"/>
                <field name="instance"/>
                <field name="ip"/>
            </list>
        </field>
    </record>

    <record id="view_bestpay_event_log_form" model="ir.ui.view">
        <field name="name">event.log.form</field>
        <field name="model">event.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="timestamp"/>
                            <field name="is_error"/>
                            <field name="controller"/>
                            <field name="function_name"/>
                            <field name="origin"/>
                            <field name="dedupe_key"/>
                        </group>
                        <group>
                            <field name="user"/>
                            <field name="instance"/>
                            <field name="ip"/>
                            <field name="http_method"/>
                            <field name="request_url"/>
                            <field name="duration_ms"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Contexto">
                        <field name="meta" nolabel="1"/>
                    </group>
                    <group string="Entrada">
                        <field name="input" nolabel="1"/>
                    </group>
                    <group string="Salida">
                        <field name="output" nolabel="1"/>
                    </group>
                    <group string="Detalles de Error">
                        <field name="error_detail_ids" nolabel="1">
                            <list>
                                <field name="function_name"/>
                                <field name="error_type"/>
                                <field name="notified"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bestpay_event_log_search" model="ir.ui.view">
        <field name="name">event.log.search</field>
        <field name="model">event.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="function_name"/>
                <field name="user"/>
                <field name="instance"/>
                <filter name="only_errors" string="Solo errores"
                        domain="[('is_error', '=', True)]"/>
                <separator/>
                <filter name="group_controller" string="Controlador"
                        context="{'group_by': 'controller'}"/>
                <filter name="group_is_error" string="Error"
                        context="{'group_by': 'is_error'}"/>
                <filter name="group_instance" string="Instancia"
                        context="{'group_by': 'instance'}"/>
            </search>
        </field>
    </record>

    <record id="action_bestpay_event_log" model="ir.actions.act_window">
        <field name="name">Event Logs</field>
        <field name="res_model">event.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bestpay_event_log"
              name="Event Logs"
              parent="bestpay.menu_bestpay_errors_root"
              action="action_bestpay_event_log"
              sequence="10"/>
</odoo>
