<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ===================================================== -->
        <!-- TEMPLATE 1: FORMULARIO DE PAGO STANDALONE             -->
        <!-- ===================================================== -->
        <template id="bdv_checkout_form" name="BDV Checkout Form">
            <html>
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title>Pago Seguro - BestPay</title>
                    <!-- Bootstrap 5 desde CDN -->
                    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
                    <!-- Font Awesome para iconos -->
                    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
                    <style>
                        body {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            min-height: 100vh;
                            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                        }
                        .payment-card {
                            border: none;
                            border-radius: 20px;
                            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                        }
                        .card-header-bdv {
                            background: linear-gradient(135deg, #0033a0 0%, #002270 100%);
                            color: white;
                            border-radius: 20px 20px 0 0 !important;
                            border-bottom: 5px solid #ffd700;
                        }
                        .amount-box {
                            background: #f8f9fa;
                            border-radius: 15px;
                            border: 2px solid #e9ecef;
                        }
                        .amount-value {
                            color: #0033a0;
                            font-weight: 800;
                            font-size: 2rem;
                        }
                        .btn-bdv {
                            background: linear-gradient(135deg, #0033a0 0%, #002270 100%);
                            border: none;
                            color: white;
                            font-weight: 700;
                            padding: 15px;
                            border-radius: 10px;
                            transition: all 0.3s;
                        }
                        .btn-bdv:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 10px 20px rgba(0,51,160,0.3);
                            color: white;
                        }
                        .form-label {
                            font-weight: 600;
                            color: #495057;
                            font-size: 0.875rem;
                        }
                        .form-control, .form-select {
                            border-radius: 10px;
                            border: 2px solid #e9ecef;
                            padding: 12px;
                        }
                        .form-control:focus, .form-select:focus {
                            border-color: #0033a0;
                            box-shadow: 0 0 0 0.2rem rgba(0,51,160,0.15);
                        }
                        .badge-reference {
                            background: #e7f3ff;
                            color: #0033a0;
                            padding: 8px 15px;
                            border-radius: 20px;
                            font-weight: 600;
                        }
                    </style>
                </head>
                <body>
                    <div class="container py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="card payment-card">
                                    <!-- Encabezado -->
                                    <div class="card-header card-header-bdv text-center py-4">
                                        <h3 class="mb-1">
                                            <i class="fa fa-shield me-2"></i> Pasarela de Pago Seguro
                                        </h3>
                                        <p class="small mb-0 opacity-75">Procesado por BestPay - Banco de Venezuela</p>
                                    </div>

                                    <div class="card-body p-4 p-md-5">
                                        <!-- Resumen del Monto -->
                                        <div class="amount-box p-4 text-center mb-4">
                                            <p class="text-muted small text-uppercase fw-bold mb-1">
                                                Monto a Cancelar
                                            </p>
                                         <!-- Mostrar monto en Bs usando amount_ves calculado por Wilson -->
                                        <h2 class="amount-value mb-2">
                                            <t t-if="transaction.amount_ves">
                                                <t t-esc="'{:,.2f}'.format(transaction.amount_ves).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                                <span style="font-size: 1rem; vertical-align: super;">Bs</span>
                                            </t>
                                            <t t-else="">
                                                <!-- Fallback de seguridad -->
                                                <t t-esc="'%.2f' % transaction.amount"/>
                                                <t t-esc="transaction.currency_id.name"/>
                                            </t>
                                        </h2>
                                        <t t-if="transaction.exchange_rate_bcv">
                                            <p class="text-muted small mb-0 mt-1">
                                                <i class="fa fa-info-circle me-1"></i>
                                                Tasa BCV: <t t-esc="transaction.exchange_rate_bcv"/> Bs/$ 
                                                <span class="mx-2">/</span>
                                                Precio: $<t t-esc="'%.2f' % (transaction.amount_ves / transaction.exchange_rate_bcv if transaction.exchange_rate_bcv else transaction.amount)"/>
                                            </p>
                                        </t>
                                    </div>

                                        <!-- Formulario de Pago Móvil -->
                                        <form action="/pago/bdv/procesar" method="post">
                                            <input type="hidden" name="hash" t-att-value="hash"/>

                                            <h5 class="text-muted mb-3 fw-bold">
                                                <i class="fa fa-mobile me-2"></i> Datos del Pago Móvil
                                            </h5>

                                            <!-- Banco de Origen -->
                                            <div class="mb-3">
                                                <label class="form-label">Banco Emisor</label>
                                                <select class="form-select" name="banco" required="1">
                                                    <option value="0102">0102 - Banco de Venezuela</option>
                                                    <option value="0105">0105 - Mercantil</option>
                                                    <option value="0108">0108 - Provincial</option>
                                                    <option value="0134">0134 - Banesco</option>
                                                    <option value="0104">0104 - Venezolano de Crédito</option>
                                                    <option value="0172">0172 - Bancamiga</option>
                                                    <option value="0175">0175 - Banco del Tesoro</option>
                                                    <option value="0128">0128 - Banco Caroní</option>
                                                </select>
                                            </div>

                                            <!-- Teléfono del Pagador -->
                                            <div class="mb-3">
                                                <label class="form-label">Teléfono del Pagador</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-white">+58</span>
                                                    <input type="text" 
                                                           class="form-control" 
                                                           name="telefono" 
                                                           placeholder="4121234567" 
                                                           maxlength="11" 
                                                           pattern="[0-9]{10,11}"
                                                           required="1"/>
                                                </div>
                                                <small class="text-muted">Sin el 0 inicial. Ej: 4121234567</small>
                                            </div>

                                            <!-- Cédula del Pagador -->
                                            <div class="mb-3">
                                                <label class="form-label">Cédula del Pagador</label>
                                                <div class="input-group">
                                                    <select class="form-select" style="max-width: 90px;" name="tipo_cedula">
                                                        <option value="V">V</option>
                                                        <option value="E">E</option>
                                                        <option value="J">J</option>
                                                        <option value="G">G</option>
                                                    </select>
                                                    <input type="text" 
                                                           class="form-control" 
                                                           name="cedula" 
                                                           placeholder="12345678" 
                                                           maxlength="10" 
                                                           pattern="[0-9]{6,10}"
                                                           required="1"/>
                                                </div>
                                            </div>

                                            <!-- Referencia de la Operación -->
                                            <div class="mb-3">
                                                <label class="form-label">Número de Referencia</label>
                                                <input type="text" 
                                                       class="form-control" 
                                                       name="referencia" 
                                                       placeholder="Últimos 6-8 dígitos de la referencia" 
                                                       maxlength="10"
                                                       required="1"/>
                                                <small class="text-muted">Lo encuentras en tu comprobante de pago móvil</small>
                                            </div>

                                            <!-- Botones -->
                                            <div class="d-grid gap-2">
                                                <button type="submit" class="btn btn-bdv btn-lg">
                                                    <i class="fa fa-lock me-2"></i> Procesar Pago Seguro
                                                </button>
                                                <a href="about:blank" class="btn btn-light btn-lg border text-muted">
                                                    Cancelar
                                                </a>
                                            </div>

                                            <!-- Monto Transferido (Automático) -->
                                            <div class="mb-4">
                                                <!-- Campo oculto por compatibilidad, aunque el monto real se fuerza en el backend -->
                                                <input type="hidden" name="importe" t-att-value="transaction.amount_ves or transaction.amount"/>
                                            </div>

                                            <div class="text-center mt-3">
                                                <small class="text-muted">
                                                    <i class="fa fa-shield text-success"></i> 
                                                    Conexión segura y encriptada
                                                </small>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bootstrap JS -->
                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                </body>
            </html>
        </template>

        <!-- ===================================================== -->
        <!-- TEMPLATE 2: PÁGINA DE RESULTADO (ÉXITO / ERROR)       -->
        <!-- ===================================================== -->
        <template id="bdv_checkout_result" name="BDV Checkout Result">
            <html>
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title>Resultado del Pago - BestPay</title>
                    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
                    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
                    <style>
                        body {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            min-height: 100vh;
                        }
                        .result-card {
                            border: none;
                            border-radius: 20px;
                            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                        }
                        .result-icon {
                            font-size: 5rem;
                            margin-bottom: 20px;
                        }
                        .success-icon { color: #28a745; }
                        .error-icon { color: #dc3545; }

                        .bp-ref-wrapper{
                            position: relative;
                            display: inline-block;
                        }
                        .bp-copy-icon{
                            position: absolute;
                            left: 100%;
                            top: 50%;
                            transform: translateY(-50%);
                            margin-left: 10px;
                            display: inline-flex; align-items: center; justify-content: center;
                            width: 30px; height: 30px;
                            border: 1.5px solid #0033a0; border-radius: 8px;
                            background: #fff; color: #0033a0; cursor: pointer;
                            font-size: 13px; line-height: 1;
                            transition: background .18s ease, color .18s ease, border-color .18s ease, transform .12s ease, box-shadow .18s ease;
                        }
                        .bp-copy-icon:hover{ background:#0033a0; color:#fff; box-shadow:0 4px 12px rgba(0,51,160,.25); }
                        .bp-copy-icon:active{ transform: translateY(-50%) scale(.92); }
                        .bp-copy-icon.is-copied{ background:#1f9d55; border-color:#1f9d55; color:#fff; box-shadow:0 4px 12px rgba(31,157,85,.3); animation: bp-pop .3s ease; }
                        @keyframes bp-pop{ 0%{ transform: translateY(-50%) scale(.8); } 50%{ transform: translateY(-50%) scale(1.12); } 100%{ transform: translateY(-50%) scale(1); } }
                        .bp-copy-btn i{ font-size:12px; }
                    </style>
                </head>
                <body>
                    <div class="container py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-6">
                                <div class="card result-card">
                                    <div class="card-body p-5 text-center">
                                        <t t-if="status == 'success'">
                                            <i class="fa fa-check-circle result-icon success-icon"></i>
                                            <h2 class="text-success mb-3">¡Pago Exitoso!</h2>
                                            <p class="lead text-muted mb-4">
                                                Tu pago ha sido procesado correctamente por el Banco de Venezuela.
                                            </p>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-times-circle result-icon error-icon"></i>
                                            <h2 class="text-danger mb-3">Pago Rechazado</h2>
                                            <p class="lead text-muted mb-4">
                                                <t t-esc="message"/>
                                            </p>
                                        </t>

                                        <div class="bg-light rounded p-3 mb-4">
                                            <p class="mb-1 small text-muted">Referencia Externa</p>
                                            <div class="bp-ref-wrapper">
                                                <span class="fw-bold mb-0"><t t-esc="transaction.external_reference or 'N/A'"/></span>
                                                <button type="button" class="bp-copy-icon"
                                                        t-att-data-copy="transaction.external_reference or ''"
                                                        onclick="bpCopyToClipboard(this.getAttribute('data-copy'), this)"
                                                        title="Copiar referencia" aria-label="Copiar referencia">
                                                    <i class="fa fa-copy"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- ====== DATOS DEL PAGADOR (solo C2P y solo en pago exitoso) ====== -->
                                        <t t-if="transaction.bdv_c2p_customer_document_id and status == 'success'">
                                            <t t-set="c2p_banks" t-value="{'0102':'Banco de Venezuela','0105':'Mercantil','0108':'Provincial','0134':'Banesco','0104':'Venezolano de Crédito','0172':'Bancamiga','0175':'Banco del Tesoro','0128':'Banco Caroní'}"/>
                                            <div class="bg-light rounded p-3 mb-4 text-start">
                                                <p class="mb-2 small text-muted text-uppercase" style="letter-spacing:1px;">Datos del Pagador</p>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Cédula:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="transaction.bdv_c2p_customer_document_id"/></div>
                                                </div>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Teléfono:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="transaction.bdv_c2p_customer_phone"/></div>
                                                </div>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Banco:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="c2p_banks.get(transaction.bdv_c2p_customer_bank_code) or transaction.bdv_c2p_customer_bank_code"/></div>
                                                </div>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Monto:</strong></div>
                                                    <div class="col-7 text-end">
                                                        <t t-if="transaction.amount_ves">
                                                            <t t-esc="'{:,.2f}'.format(transaction.amount_ves).replace(',', 'X').replace('.', ',').replace('X', '.')"/> Bs
                                                        </t>
                                                        <t t-else="">
                                                            <t t-esc="'%.2f' % transaction.amount"/> <t t-esc="transaction.currency_id.name"/>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-5"><strong>Fecha:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="transaction.create_date.strftime('%d/%m/%Y %H:%M')"/></div>
                                                </div>
                                            </div>
                                        </t>

                                                                                <!-- ====== DATOS DEL PAGADOR (solo Pago Móvil y solo en pago exitoso) ====== -->
                                        <t t-if="transaction.bdv_cedula_pagador and status == 'success'">
                                            <t t-set="pm_banks" t-value="{'0102':'Banco de Venezuela','0105':'Mercantil','0108':'Provincial','0134':'Banesco','0104':'Venezolano de Crédito','0172':'Bancamiga','0175':'Banco del Tesoro','0128':'Banco Caroní'}"/>
                                            <div class="bg-light rounded p-3 mb-4 text-start">
                                                <p class="mb-2 small text-muted text-uppercase" style="letter-spacing:1px;">Datos del Pagador</p>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Cédula:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="transaction.bdv_cedula_pagador"/></div>
                                                </div>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Teléfono:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="transaction.bdv_telefono_pagador"/></div>
                                                </div>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Banco:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="pm_banks.get(transaction.bdv_banco_origen) or transaction.bdv_banco_origen or 'N/A'"/></div>
                                                </div>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Referencia:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="transaction.bdv_referencia or transaction.external_reference or 'N/A'"/></div>
                                                </div>
                                                <div class="row mb-1">
                                                    <div class="col-5"><strong>Monto:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="'{:,.2f}'.format(transaction.bdv_importe or 0).replace(',', 'X').replace('.', ',').replace('X', '.')"/> Bs</div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-5"><strong>Fecha:</strong></div>
                                                    <div class="col-7 text-end"><t t-esc="transaction.bdv_fecha_pago and transaction.bdv_fecha_pago.strftime('%d/%m/%Y') or transaction.create_date.strftime('%d/%m/%Y %H:%M')"/></div>
                                                </div>
                                            </div>
                                        </t>

                                        <div class="d-grid gap-2">
                                            <a href="about:blank" class="btn btn-primary btn-lg">
                                                <i class="fa fa-arrow-left me-2"></i> Volver al Comercio
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <script type="text/javascript">
                        function bpCopyToClipboard(text, btn){
                            if(!text || !btn){ return; }
                            var original = btn.innerHTML;
                            var done = function(){
                                btn.classList.add('is-copied');
                                btn.innerHTML = '<i class="fa fa-check"></i>';
                                setTimeout(function(){
                                    btn.classList.remove('is-copied');
                                    btn.innerHTML = original;
                                }, 1800);
                            };
                            if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText){
                                navigator.clipboard.writeText(text).then(done).catch(function(){ bpFallbackCopy(text, done); });
                            } else {
                                bpFallbackCopy(text, done);
                            }
                        }
                        function bpFallbackCopy(text, done){
                            var ta = document.createElement('textarea');
                            ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
                            document.body.appendChild(ta); ta.select();
                            try { document.execCommand('copy'); } catch(e){}
                            document.body.removeChild(ta); done();
                        }
                    </script>
                </body>
            </html>
        </template>
    </data>
</odoo>