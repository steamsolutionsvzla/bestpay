<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="c2p_checkout_form" name="BDV C2P Checkout Form">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Pago Seguro C2P - BestPay</title>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
                <style>
                    body {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        min-height: 100vh;
                        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    }
                    .step-indicator-float {
                        position: fixed;
                        left: 50px;
                        top: 50%;
                        transform: translateY(-50%);
                        z-index: 1000;
                        width: 280px;
                    }
                    @media (max-width: 1200px) {
                        .step-indicator-float {
                            position: relative;
                            left: auto;
                            top: auto;
                            transform: none;
                            width: 100%;
                            margin-bottom: 20px;
                        }
                    }
                    .payment-card {
                        border: none;
                        border-radius: 20px;
                        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                    }
                    .card-header-bdv {
                        background: linear-gradient(135deg, #0033a0 0%, #002270 100%);
                        color: white;
                        border-radius: 20px 20px 0 0 !important;
                        border-bottom: 5px solid #ffd700;
                    }
                    .amount-box {
                        background: #f8f9fa;
                        border-radius: 15px;
                        border: 2px solid #e9ecef;
                    }
                    .amount-value {
                        color: #0033a0;
                        font-weight: 800;
                        font-size: 2rem;
                    }
                    .btn-bdv {
                        background: linear-gradient(135deg, #0033a0 0%, #002270 100%);
                        border: none;
                        color: white;
                        font-weight: 700;
                        padding: 15px;
                        border-radius: 10px;
                        transition: all 0.3s;
                    }
                    .btn-bdv:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 10px 20px rgba(0,51,160,0.3);
                        color: white;
                    }
                    .btn-bdv:disabled {
                        background: #99b3e6;
                        cursor: not-allowed;
                        transform: none;
                        box-shadow: none;
                    }
                    .form-label {
                        font-weight: 600;
                        color: #495057;
                        font-size: 0.875rem;
                    }
                    .form-control, .form-select {
                        border-radius: 10px;
                        border: 2px solid #e9ecef;
                        padding: 12px;
                    }
                    .form-control:focus, .form-select:focus {
                        border-color: #0033a0;
                        box-shadow: 0 0 0 0.2rem rgba(0,51,160,0.15);
                    }
                    .hidden { display: none; }
                    .error-msg { color: #d32f2f; background: #ffebee; padding: 0.75rem; border-radius: 10px; margin-bottom: 1rem; font-size: 0.9rem; border: 1px solid #f5c6cb; }
                    .info-box { background: #e3f2fd; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.9rem; color: #0d47a1; border: 1px solid #b3d7ff; }
                </style>
            </head>
            <body>
                <div id="tx-data" t-att-data-hash="hash" style="display: none;"></div>

                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            
                            <!-- Indicador flotante a la izquierda -->
                            <div class="step-indicator-float">
                                <div class="d-flex align-items-center" style="background: rgba(255,255,255,0.15); border-radius: 15px; padding: 20px; backdrop-filter: blur(10px);">
                                    <div id="step-number-display" style="background: white; color: #0033a0; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.3rem; margin-right: 15px; flex-shrink: 0;">1</div>
                                    <div>
                                        <div id="step-title-display" style="font-size: 1.3rem; font-weight: 700; color: white; margin-bottom: 5px;">Identifícate</div>
                                        <div id="step-subtitle-display" style="font-size: 0.9rem; color: rgba(255,255,255,0.9);">Siguiente paso: Verifica tu operación</div>
                                        <div id="step-counter-display" style="font-size: 0.85rem; color: rgba(255,255,255,0.75); margin-top: 5px;">1 de 2</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Formulario centrado -->
                            <div class="card payment-card">
                                <div class="card-header card-header-bdv text-center py-4">
                                    <h3 class="mb-1">
                                        <i class="fa fa-shield me-2"></i> Pasarela de Pago Seguro C2P
                                    </h3>
                                    <p class="small mb-0 opacity-75">Procesado por BestPay - Banco de Venezuela</p>
                                </div>
                                
                                <div class="card-body p-4 p-md-5">
                                    <div class="amount-box p-4 text-center mb-4">
                                        <p class="text-muted small text-uppercase fw-bold mb-1">Monto a Cancelar</p>
                                        <h2 class="amount-value mb-2">
                                            <t t-if="transaction.amount_ves">
                                                <t t-esc="'{:,.2f}'.format(transaction.amount_ves).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                                <span style="font-size: 1rem; vertical-align: super;">Bs</span>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="'%.2f' % transaction.amount"/>
                                                <t t-esc="transaction.currency_id.name"/>
                                            </t>
                                        </h2>
                                        <t t-if="transaction.exchange_rate_bcv">
                                            <p class="text-muted small mb-0 mt-1">
                                                <i class="fa fa-info-circle me-1"></i>
                                                Tasa BCV: <t t-esc="transaction.exchange_rate_bcv"/> Bs/$ 
                                                <span class="mx-2">/</span>
                                                Precio: $<t t-esc="'%.2f' % (transaction.amount_ves / transaction.exchange_rate_bcv if transaction.exchange_rate_bcv else transaction.amount)"/>
                                            </p>
                                        </t>        
                                        <div class="mt-2">
                                            <div style="font-size: 0.85rem; color: #6c757d; font-weight: 500;">
                                                <t t-esc="transaction.reference or ''"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="error-container" class="error-msg hidden"></div>
                                    <div id="success-container" class="success-msg hidden"></div>

                                    <form id="step1-form">
                                        <h5 class="text-muted mb-3 fw-bold">
                                            <i class="fa fa-user me-2"></i> Datos del Pagador
                                        </h5>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">Cédula de Identidad</label>
                                            <div class="input-group">
                                                <select class="form-select" id="customer_doc_type" style="max-width: 90px;">
                                                    <option value="V">V</option>
                                                    <option value="E">E</option>
                                                    <option value="J">J</option>
                                                    <option value="G">G</option>
                                                </select>
                                                <input type="text" class="form-control" id="customer_doc_number" placeholder="12345678" maxlength="10" pattern="[0-9]{6,10}" required="1"/>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Teléfono Móvil</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">+58</span>
                                                <input type="text" class="form-control" id="customer_phone" placeholder="4121234567" maxlength="11" pattern="[0-9]{10,11}" required="1"/>
                                            </div>
                                            <small class="text-muted">Sin el 0 inicial. Ej: 4121234567</small>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Banco Emisor</label>
                                            <select class="form-select" id="customer_bank_code" required="1">
                                                <option value="0102">0102 - Banco de Venezuela</option>
                                                <option value="0105">0105 - Mercantil</option>
                                                <option value="0108">0108 - Provincial</option>
                                                <option value="0134">0134 - Banesco</option>
                                                <option value="0104">0104 - Venezolano de Crédito</option>
                                                <option value="0172">0172 - Bancamiga</option>
                                                <option value="0175">0175 - Banco del Tesoro</option>
                                                <option value="0128">0128 - Banco Caroní</option>
                                            </select>
                                        </div>

                                        <div class="d-grid gap-2 mt-4">
                                            <button type="submit" class="btn btn-bdv btn-lg" id="btn-generate-otp">
                                                <i class="fa fa-arrow-right me-2"></i> Continuar
                                            </button>
                                        </div>
                                    </form>

                                    <form id="step2-form" class="hidden">
                                        <div class="info-box text-center">
                                            <i class="fa fa-envelope-open-text fa-2x mb-2 d-block"></i>
                                            Se ha enviado un código OTP a su teléfono. Por favor, ingréselo a continuación para autorizar el cobro.
                                        </div>
                                        
                                        <div class="mb-4">
                                            <label class="form-label">Código OTP</label>
                                            <input type="text" class="form-control text-center fw-bold fs-4" id="otp_code" placeholder="5551111" maxlength="10" required="1" style="letter-spacing: 5px;"/>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button type="submit" class="btn btn-bdv btn-lg" id="btn-process-payment">
                                                <i class="fa fa-lock me-2"></i> Confirmar y Pagar
                                            </button>
                                            <button type="button" class="btn btn-light btn-lg border text-muted" id="btn-back">
                                                <i class="fa fa-arrow-left me-2"></i> Volver
                                            </button>
                                        </div>
                                    </form>

                                    <div class="text-center mt-4">
                                        <small class="text-muted">
                                            <i class="fa fa-shield text-success"></i> Conexión segura y encriptada
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                
                                <script type="text/javascript">
                    var uuidHash = document.getElementById('tx-data').getAttribute('data-hash');
                    var errorContainer = document.getElementById('error-container');
                    var currentStep = 1;

                    function showError(msg) {
                        if (errorContainer) {
                            errorContainer.textContent = msg;
                            errorContainer.classList.remove('hidden');
                        }
                    }

                    function updateStepIndicator(step) {
                        var stepNumber = document.getElementById('step-number-display');
                        var stepTitle = document.getElementById('step-title-display');
                        var stepSubtitle = document.getElementById('step-subtitle-display');
                        var stepCounter = document.getElementById('step-counter-display');
                        if (step === 1) {
                            if (stepNumber) stepNumber.textContent = '1';
                            if (stepTitle) stepTitle.textContent = 'Identifícate';
                            if (stepSubtitle) stepSubtitle.textContent = 'Siguiente paso: Verifica tu operación';
                            if (stepCounter) stepCounter.textContent = '1 de 2';
                        } else if (step === 2) {
                            if (stepNumber) stepNumber.textContent = '2';
                            if (stepTitle) stepTitle.textContent = 'Ingresa tu clave de pago';
                            if (stepSubtitle) stepSubtitle.textContent = 'Ultimo paso: Confirma tu pago';
                            if (stepCounter) stepCounter.textContent = '2 de 2';
                        }
                    }

                    document.addEventListener('DOMContentLoaded', function() {
                        var step1Form = document.getElementById('step1-form');
                        var step2Form = document.getElementById('step2-form');
                        var btnBack = document.getElementById('btn-back');

                        if (step1Form) {
                            step1Form.addEventListener('submit', async function(e) {
                                e.preventDefault();
                                var btn = document.getElementById('btn-generate-otp');
                                if (btn) {
                                    btn.disabled = true;
                                    btn.innerHTML = '&lt;i class="fa fa-spinner fa-spin me-2"&gt;&lt;/i&gt; Procesando...';
                                }
                                if (errorContainer) errorContainer.classList.add('hidden');

                                var docType = document.getElementById('customer_doc_type').value;
                                var docNumber = document.getElementById('customer_doc_number').value;
                                var fullDocId = docType + docNumber;
                                var rawPhone = document.getElementById('customer_phone').value.trim();
                                var fullPhone = rawPhone.startsWith('0') ? rawPhone : '0' + rawPhone;

                                var payload = {
                                    jsonrpc: "2.0",
                                    method: "call",
                                    params: {
                                        uuid_hash: uuidHash,
                                        customer_document_id: fullDocId,
                                        customer_phone: fullPhone,
                                        customer_bank_code: document.getElementById('customer_bank_code').value
                                    }
                                };

                                try {
                                    var response = await fetch('/api/bestpay/v1/c2p/generate_otp', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(payload)
                                    });
                                    var data = await response.json();

                                    if (data.result &amp;&amp; data.result.success) {
                                        if (step1Form) step1Form.classList.add('hidden');
                                        if (step2Form) step2Form.classList.remove('hidden');
                                        currentStep = 2;
                                        updateStepIndicator(currentStep);
                                        if (btn) {
                                            btn.disabled = false;
                                            btn.innerHTML = '&lt;i class="fa fa-arrow-right me-2"&gt;&lt;/i&gt; Continuar';
                                        }
                                    } else {
                                        var errMsg = "Error de conexion con el servidor.";
                                        if (data.result &amp;&amp; data.result.error) {
                                            errMsg = data.result.error;
                                        }
                                        showError(errMsg);
                                        if (btn) {
                                            btn.disabled = false;
                                            btn.innerHTML = '&lt;i class="fa fa-arrow-right me-2"&gt;&lt;/i&gt; Continuar';
                                        }
                                    }
                                } catch (err) {
                                    showError("Error de red. Intente nuevamente.");
                                    if (btn) {
                                        btn.disabled = false;
                                        btn.innerHTML = '&lt;i class="fa fa-arrow-right me-2"&gt;&lt;/i&gt; Continuar';
                                    }
                                }
                            });
                        }

                        if (step2Form) {
                            step2Form.addEventListener('submit', async function(e) {
                                e.preventDefault();
                                var btn = document.getElementById('btn-process-payment');
                                if (btn) {
                                    btn.disabled = true;
                                    btn.innerHTML = '&lt;i class="fa fa-spinner fa-spin me-2"&gt;&lt;/i&gt; Procesando pago...';
                                }
                                if (errorContainer) errorContainer.classList.add('hidden');

                                var payload = {
                                    jsonrpc: "2.0",
                                    method: "call",
                                    params: {
                                        uuid_hash: uuidHash,
                                        otp: document.getElementById('otp_code').value
                                    }
                                };

                                try {
                                    var response = await fetch('/api/bestpay/v1/c2p/process_payment', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(payload)
                                    });
                                    var data = await response.json();

                                    if (data.result &amp;&amp; data.result.success) {
                                        if (data.result.redirect_url) {
                                            window.location.href = data.result.redirect_url;
                                        }
                                    } else {
                                        var errMsg = "El banco rechazo el pago.";
                                        if (data.result &amp;&amp; data.result.error) {
                                            errMsg = data.result.error;
                                        }
                                        showError(errMsg);
                                        if (btn) {
                                            btn.disabled = false;
                                            btn.innerHTML = '&lt;i class="fa fa-lock me-2"&gt;&lt;/i&gt; Confirmar y Pagar';
                                        }
                                    }
                                } catch (err) {
                                    showError("Error de red. Intente nuevamente.");
                                    if (btn) {
                                        btn.disabled = false;
                                        btn.innerHTML = '&lt;i class="fa fa-lock me-2"&gt;&lt;/i&gt; Confirmar y Pagar';
                                    }
                                }
                            });
                        }

                        if (btnBack) {
                            btnBack.addEventListener('click', function() {
                                if (step2Form) step2Form.classList.add('hidden');
                                if (step1Form) step1Form.classList.remove('hidden');
                                if (errorContainer) errorContainer.classList.add('hidden');
                                var btn = document.getElementById('btn-generate-otp');
                                if (btn) {
                                    btn.disabled = false;
                                    btn.innerHTML = '&lt;i class="fa fa-arrow-right me-2"&gt;&lt;/i&gt; Continuar';
                                }
                                currentStep = 1;
                                updateStepIndicator(currentStep);
                            });
                        }
                    });
                </script>
            </body>
        </html>
    </template>
</odoo>