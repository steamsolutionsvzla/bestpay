<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ===================================================== -->
        <!-- HEREDAR LA VISTA DE PAYMENT.PROVIDER PARA MOSTRAR     -->
        <!-- LOS CAMPOS ESPECÍFICOS DEL BDV                         -->
        <!-- ===================================================== -->
        <record id="payment_provider_form_view_bdv" model="ir.ui.view">
            <field name="name">payment.provider.form.bdv</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <!-- Agregamos los campos BDV dentro del formulario existente -->
                <xpath expr="//sheet" position="inside">
                    <!-- Solo visible cuando el código sea 'bdv' -->
                    <group string="Configuración Banco de Venezuela" 
                           invisible="code != 'bdv'">
                        <group>
                            <field name="bdv_api_key" 
                                   password="True"
                                   placeholder="Ej: 96R7T1T5J2134T5YFC2GF15SDFG4BD1Z"/>
                            <field name="bdv_api_url" 
                                   placeholder="https://bdvconciliacionqa.banvenez.com:444/getMovement/v2"/>
                        </group>
                        <group>
                            <field name="bdv_telefono_destino" 
                                   placeholder="04127141363"/>
                            <field name="bdv_environment"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>