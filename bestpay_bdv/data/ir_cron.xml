<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 🔔 CRON: Envío asíncrono de webhooks al tercero (solo para reintentos) -->
        <record id="ir_cron_bestpay_webhook_sender" model="ir.cron">
            <field name="name">BestPay: Enviar Webhooks al Tercero</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="state">code</field>
            <field name="code">model._bestpay_process_pending_webhooks()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>