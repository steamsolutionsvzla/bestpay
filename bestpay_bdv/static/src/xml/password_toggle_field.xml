<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="bestpay_bdv.PasswordToggleField">
        <div class="o_password_toggle_field">
            <input t-att-type="inputType"
                    class="o_input"
                    t-att-value="props.record.data[props.name]"
                    t-att-readonly="props.readonly"
                    t-att-placeholder="props.placeholder"
                    t-on-input="onInput"/>
            <button type="button"
                    class="o_password_toggle_btn"
                    t-on-click="toggleVisibility"
                    title="Mostrar/Ocultar">
                <i t-attf-class="fa {{ toggleState.visible ? 'fa-eye-slash' : 'fa-eye' }}"/>
            </button>
        </div>
    </t>
</templates>